# Copy this file to .env (project root) and fill in real values.
# .env is gitignored — never commit real credentials.

# --- Required ---
# PostgreSQL connection string for the backend.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE_NAME
# JWT signing key. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY

# --- CORS / frontend ---
# Single deployed frontend origin (no trailing slash).
FRONTEND_URL=https://your-frontend.vercel.app
# Optional comma-separated extra origins (e.g. preview deployments, custom domain).
# Leave empty if not needed.
CORS_ORIGINS=

# --- Optional AI triage (feature degrades to rule-based engine when unset) ---
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
